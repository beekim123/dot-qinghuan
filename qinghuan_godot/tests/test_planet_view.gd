extends SceneTree
const Model = preload("res://scripts/planet_model.gd")
const View = preload("res://scripts/planet_view.gd")
func _init() -> void:
	call_deferred("run")
func run() -> void:
	var model = Model.new()
	model.generate(7821)
	var view = View.new()
	root.add_child(view)
	view.setup(model)
	view.set_candidates([{"cell":model.landing,"type":"battle"},{"cell":model.springs[2].cell,"type":"boss"}])
	for i in range(90):
		view._process(1.0/60.0)
	assert(view.is_front(model.landing))
	var p: Vector3 = view.globe.to_global(model.cells[model.landing].dir*2.2)
	assert(view.pick(view.camera.unproject_position(p))==model.landing,"Focused marker selectable")
	view.handle_drag(Vector2(PI/0.012,0))
	assert(not view.is_front(model.landing),"Back marker hidden")
	assert(view.pick(view.camera.unproject_position(view.globe.to_global(model.cells[model.landing].dir*2.2))) != model.landing,"Back marker cannot be picked")
	view.focus_cell(model.springs[2].cell)
	for i in range(90): view._process(1.0/60.0)
	assert(view.is_front(model.springs[2].cell),"Back node accessible through focus")
	view.handle_drag(Vector2(0,PI/0.012))
	view.focus_cell(model.landing)
	for i in range(90): view._process(1.0/60.0)
	assert(view.is_front(model.landing),"Pole rotation does not lock")
	print("PLANET VIEW PASS: mesh construction, focus, front pick, back rejection, backside focus, all-axis rotation.")
	view.queue_free()
	quit()
